rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contact Form Submissions
    match /contactMessages/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Community Application Submissions
    match /communityApplications/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Public expert 1:1 call requests. Scheduling remains authenticated.
    match /expertCallRequests/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Public insight subscriptions. Only a normalized active email subscription
    // can be created or refreshed; subscriber data remains private.
    match /insightSubscribers/{document} {
      function isValidPublicSubscription(data) {
        return data.email is string &&
          data.email.size() >= 5 &&
          data.email.size() <= 320 &&
          data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
          data.status == 'active' &&
          data.source in ['insights-page', 'insight-detail'];
      }

      allow create: if
        request.resource.data.keys().hasOnly([
          'email',
          'status',
          'source',
          'subscribedAt',
          'updatedAt'
        ]) && isValidPublicSubscription(request.resource.data);

      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'status',
          'source',
          'subscribedAt',
          'updatedAt'
        ]) && isValidPublicSubscription(request.resource.data);

      allow read, delete: if request.auth != null;
    }

    // All other collections require authentication.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
